{
  "name": "@telus/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ts-node -r tsconfig-paths/register src/main.ts",
    "migrate": "ts-node -r tsconfig-paths/register src/db/migrate.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "test:db": "REQUIRE_DB_TESTS=1 jest --runInBand test/rls.spec.ts test/bids.spec.ts test/lifecycle.spec.ts test/realtime.e2e.spec.ts test/admin.spec.ts",
    "test:redis": "REQUIRE_REDIS_TESTS=1 jest --runInBand test/realtime-cluster.e2e.spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/throttler": "^6.2.1",
    "@nestjs/websockets": "^10.4.22",
    "@socket.io/redis-adapter": "^8.3.0",
    "@telus/shared": "*",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "pg": "^8.13.0",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.16.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "moduleNameMapper": {
      "^@telus/shared$": "<rootDir>/../../packages/shared/src/index.ts"
    },
    "testTimeout": 30000
  }
}
