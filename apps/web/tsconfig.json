{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "allowJs": false,
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "experimentalDecorators": false,
    "emitDecoratorMetadata": false,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"], "@telus/shared": ["../../packages/shared/src/index.ts"] }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts", "e2e/**/*.ts", "*.ts"],
  "exclude": ["node_modules"]
}
