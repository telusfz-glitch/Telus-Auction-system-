          },
          {
            "name": "map-role-client-scope"
          },
          {
            "name": "map-roles-composite"
          }
        ],
        "decisionStrategy": "UNANIMOUS",
        "authorizationSchema": {
          "resourceTypes": {
            "Roles": {
              "type": "Roles",
              "scopes": [
                "map-role-client-scope",
                "map-role-composite",
                "map-role"
              ],
              "scopeAliases": {}
            },
            "Clients": {
              "type": "Clients",
              "scopes": [
                "map-roles-composite",
                "manage",
                "map-roles",
                "map-roles-client-scope",
                "view"
              ],
              "scopeAliases": {}
            },
            "Users": {
              "type": "Users",
              "scopes": [
                "impersonate",
                "map-roles",
                "manage",
                "manage-group-membership",
                "reset-password",
                "view"
              ],
              "scopeAliases": {
                "view": [
                  "view-members"
                ],
                "manage": [
                  "manage-members"
                ],
                "impersonate": [
                  "impersonate-members"
                ],
                "manage-group-membership": [
                  "manage-membership-of-members"
                ]
              },
              "groupType": "Groups"
            },
            "Groups": {
              "type": "Groups",
              "scopes": [
                "manage-membership",
                "manage",
                "manage-membership-of-members",
                "manage-members",
                "impersonate-members",
                "view",
                "view-members"
              ],
              "scopeAliases": {}
            }
          }
        }
      }
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"customer_id\",\"displayName\":\"Customer ID\",\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"validations\":{\"pattern\":{\"pattern\":\"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$\",\"error-message\":\"customer_id must be a UUID\"}},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  },
  "users": [
    {
      "username": "service-account-telus-api-admin",
      "enabled": true,
      "serviceAccountClientId": "telus-api-admin",
      "clientRoles": {
        "realm-management": [
          "query-users",
          "query-groups",
          "view-realm"
        ]
      }
    }
  ],
  "adminPermissionsEnabled": true,
  "groups": [
    {
      "id": "c0570000-0000-4000-8000-000000000001",
      "name": "customers",
      "path": "/customers",
      "attributes": {
        "description": [
          "Every customer login. The API's service account may manage members of this group only."
        ]
      },
      "subGroups": []
    }
  ]
}
