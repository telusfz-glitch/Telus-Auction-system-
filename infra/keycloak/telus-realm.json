{
  "realm": "telus",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "maxDeltaTimeSeconds": 43200,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "passwordPolicy": "length(14) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and notUsername and passwordHistory(5)",
  "otpPolicyType": "totp",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyInitialCounter": 0,
  "otpPolicyCodeReusable": false,
  "otpSupportedApplications": [
    "totpAppGoogleName",
    "totpAppMicrosoftAuthenticatorName",
    "totpAppFreeOTPName"
  ],
  "roles": {
    "realm": [
      {
        "name": "super_admin",
        "description": "Full staff access"
      },
      {
        "name": "auction_manager",
        "description": "Create/manage auctions and customers"
      },
      {
        "name": "sales_manager",
        "description": "View customers, results, reports"
      },
      {
        "name": "finance",
        "description": "Deposits, invoices, payments"
      },
      {
        "name": "view_only",
        "description": "Read-only staff"
      },
      {
        "name": "customer_admin",
        "description": "Customer org owner: bids + manages team logins",
        "id": "c0570000-0000-4000-8000-0000000000a1"
      },
      {
        "name": "customer_bidder",
        "description": "Customer team member who can bid",
        "id": "c0570000-0000-4000-8000-0000000000b1"
      },
      {
        "name": "customer_viewer",
        "description": "Customer team member, read-only",
        "id": "c0570000-0000-4000-8000-0000000000c1"
      }
    ]
  },
  "clients": [
    {
      "clientId": "telus-web",
      "name": "TELUS web app (server-side / BFF)",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "${TELUS_WEB_URL}/auth/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${TELUS_WEB_URL}/"
      },
      "protocolMappers": [
        {
          "name": "telus-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "telus-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "customer_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "customer_id",
            "claim.name": "customer_id",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ],
      "clientAuthenticatorType": "client-secret",
      "secret": "${TELUS_WEB_CLIENT_SECRET}",
      "frontchannelLogout": false
    },
    {
      "clientId": "telus-api",
      "name": "TELUS API (resource server)",
      "enabled": true,
      "bearerOnly": true
    },
    {
      "clientId": "telus-api-admin",
      "name": "TELUS API — customer login management (service account)",
      "description": "Used only by the API to create/suspend customer team logins. Holds user-management roles only.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${TELUS_API_ADMIN_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "frontchannelLogout": false,
      "attributes": {
        "access.token.lifespan": "120"
      }
    },
    {
      "clientId": "admin-permissions",
      "surrogateAuthRequired": false,
      "enabled": true,
      "alwaysDisplayInConsole": false,
      "redirectUris": [],
      "webOrigins": [],
      "notBefore": 0,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": true,
      "publicClient": false,
      "frontchannelLogout": false,
      "protocol": "openid-connect",
      "attributes": {
        "realm_client": "false"
      },
      "authenticationFlowBindingOverrides": {},
      "fullScopeAllowed": false,
      "nodeReRegistrationTimeout": 0,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "basic",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "organization",
        "offline_access",
        "microprofile-jwt"
      ],
      "authorizationSettings": {
        "allowRemoteResourceManagement": true,
        "policyEnforcementMode": "ENFORCING",
        "resources": [
          {
            "name": "Roles",
            "type": "Roles",
            "ownerManagedAccess": false,
            "attributes": {},
            "uris": [],
            "scopes": [
              {
                "name": "map-role-composite"
              },
              {
                "name": "map-role-client-scope"
              },
              {
                "name": "map-role"
              }
            ]
          },
          {
            "name": "Clients",
            "type": "Clients",
            "ownerManagedAccess": false,
            "attributes": {},
            "uris": [],
            "scopes": [
              {
                "name": "view"
              },
              {
                "name": "map-roles-client-scope"
              },
              {
                "name": "map-roles"
              },
              {
                "name": "manage"
              },
              {
                "name": "map-roles-composite"
              }
            ]
          },
          {
            "name": "Users",
            "type": "Users",
            "ownerManagedAccess": false,
            "attributes": {},
            "uris": [],
            "scopes": [
              {
                "name": "manage-group-membership"
              },
              {
                "name": "view"
              },
              {
                "name": "impersonate"
              },
              {
                "name": "map-roles"
              },
              {
                "name": "reset-password"
              },
              {
                "name": "manage"
              }
            ]
          },
          {
            "name": "Groups",
            "type": "Groups",
            "ownerManagedAccess": false,
            "attributes": {},
            "uris": [],
            "scopes": [
              {
                "name": "manage-members"
              },
              {
                "name": "view"
              },
              {
                "name": "manage-membership-of-members"
              },
              {
                "name": "manage-membership"
              },
              {
                "name": "view-members"
              },
              {
                "name": "manage"
              },
              {
                "name": "impersonate-members"
              }
            ]
          },
          {
            "name": "c0570000-0000-4000-8000-000000000001",
            "ownerManagedAccess": false,
            "attributes": {},
            "uris": [],
            "scopes": [
              {
                "name": "manage-members"
              },
              {
                "name": "view"
              },
              {
                "name": "manage-membership-of-members"
              },
              {
                "name": "manage-membership"
              },
              {
                "name": "view-members"
              },
              {
                "name": "manage"
              },
              {
                "name": "impersonate-members"
              }
            ]
          },
          {
            "name": "c0570000-0000-4000-8000-0000000000b1",
            "ownerManagedAccess": false,
            "attributes": {},
            "uris": [],
            "scopes": [
              {
                "name": "map-role-composite"
              },
              {
                "name": "map-role-client-scope"
              },
              {
                "name": "map-role"
              }
            ]
          },
          {
            "name": "c0570000-0000-4000-8000-0000000000c1",
            "ownerManagedAccess": false,
            "attributes": {},
            "uris": [],
            "scopes": [
              {
                "name": "map-role-composite"
              },
              {
                "name": "map-role-client-scope"
              },
              {
                "name": "map-role"
              }
            ]
          },
          {
            "name": "c0570000-0000-4000-8000-0000000000a1",
            "ownerManagedAccess": false,
            "attributes": {},
            "uris": [],
            "scopes": [
              {
                "name": "map-role-composite"
              },
              {
                "name": "map-role-client-scope"
              },
              {
                "name": "map-role"
              }
            ]
          }
        ],
        "policies": [
          {
            "name": "telus-api-admin service-account user",
            "type": "user",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "users": "[\"service-account-telus-api-admin\"]"
            }
          },
          {
            "name": "manage customer logins",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "defaultResourceType": "Groups",
              "resources": "[\"c0570000-0000-4000-8000-000000000001\"]",
              "scopes": "[\"manage-membership\",\"manage-members\",\"view-members\",\"view\"]",
              "applyPolicies": "[\"telus-api-admin service-account user\"]"
            }
          },
          {
            "name": "grant customer roles",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "defaultResourceType": "Roles",
              "resources": "[\"c0570000-0000-4000-8000-0000000000b1\", \"c0570000-0000-4000-8000-0000000000c1\", \"c0570000-0000-4000-8000-0000000000a1\"]",
              "scopes": "[\"map-role\"]",
              "applyPolicies": "[\"telus-api-admin service-account user\"]"
            }
          },
          {
            "name": "map roles on users",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "defaultResourceType": "Users",
              "resources": "[\"Users\"]",
              "scopes": "[\"map-roles\"]",
              "applyPolicies": "[\"telus-api-admin service-account user\"]"
            }
          }
        ],
        "scopes": [
          {
            "name": "manage-group-membership"
          },
          {
            "name": "map-roles-client-scope"
          },
          {
            "name": "map-role"
          },
          {
            "name": "view-members"
          },
          {
            "name": "reset-password"
          },
          {
            "name": "manage"
          },
          {
            "name": "impersonate-members"
          },
          {
            "name": "manage-members"
          },
          {
            "name": "view"
          },
          {
            "name": "manage-membership-of-members"
          },
          {
